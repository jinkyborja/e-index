generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

model College {
  id       String  @id @default(uuid()) @db.VarChar(191)
  code     String  @unique @db.VarChar(8)
  name     String  @unique @db.VarChar(120)
  isActive Boolean @default(false)
  users    User[]

  @@map("eindex_colleges")
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  passwordHash           String
  fullName               String
  role                   Role
  status                 AccountStatus           @default(PENDING)
  department             String                  @default("")
  collegeId              String?                 @db.VarChar(191)
  organizationUnit       String?                 @db.VarChar(191)
  college                College?                @relation(fields: [collegeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staffId                String?                 @unique
  registeredAt           DateTime                @default(now())
  lastLoginAt            DateTime?
  photo                  String                  @default("") @db.MediumText
  notificationPreferences Json
  appearance             String                  @default("Light")
  registration           TeacherRegistration?
  classAssignments       TeacherClass[]
  attendanceRecords      Attendance[]
  notifications          Notification[]
  auditEntries           AuditLog[]              @relation("AuditActor")
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([role, status])
  @@index([collegeId])
  @@map("eindex_users")
}

model TeacherRegistration {
  id          String             @id @default(uuid())
  userId      String             @unique
  status      RegistrationStatus @default(PENDING)
  submittedAt DateTime           @default(now())
  decidedAt   DateTime?
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@map("eindex_teacher_registrations")
}

model Student {
  id           String              @id
  name         String
  program      String
  yearLevel    String
  status       String              @default("Active")
  rfid         String?             @unique
  enrollments  StudentEnrollment[]
  attendance   Attendance[]
  grades       Grade[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("eindex_students")
}

model AcademicClass {
  id             String          @id @default(uuid())
  name           String          @unique
  course         String
  yearLevel      String
  schedule       String
  sections       ClassSection[]
  teachers       TeacherClass[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("eindex_classes")
}

model ClassSection {
  id          String              @id @default(uuid())
  classId     String
  name        String
  academicClass AcademicClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments StudentEnrollment[]
  attendance  Attendance[]
  grades      Grade[]

  @@unique([classId, name])
  @@index([classId])
  @@map("eindex_class_sections")
}

model TeacherClass {
  teacherId String
  classId   String
  teacher   User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class     AcademicClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([teacherId, classId])
  @@index([classId])
  @@map("eindex_teacher_classes")
}

model StudentEnrollment {
  studentId String
  sectionId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section   ClassSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([studentId, sectionId])
  @@index([sectionId])
  @@map("eindex_student_enrollments")
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  sectionId String
  teacherId String
  date      DateTime         @db.Date
  status    AttendanceStatus
  time      String           @default("—")
  remarks   String           @default("")
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section   ClassSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher   User             @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, sectionId, date])
  @@index([sectionId])
  @@index([teacherId, date])
  @@map("eindex_attendance")
}

model Grade {
  id           String       @id @default(uuid())
  studentId    String
  sectionId    String
  period       String
  quizzes      Float        @default(0)
  examinations Float        @default(0)
  activities   Float        @default(0)
  assessments  Float        @default(0)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section      ClassSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sectionId, period])
  @@index([sectionId])
  @@map("eindex_grades")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  detail    String
  read      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
  @@map("eindex_notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  type      String
  action    String
  detail    String
  target    String
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([type, createdAt])
  @@map("eindex_audit_logs")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("eindex_sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("eindex_password_reset_tokens")
}
