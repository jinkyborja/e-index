{
  "name": "e-index-university-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --schema server/prisma/schema.prisma",
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "start:server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:inspect": "prisma db pull --print --schema server/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "test:server": "node --test server/test/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-svelte": "^0.468.0",
    "svelte": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "prisma": "6.19.0",
    "supertest": "^7.0.0",
    "vite": "^5.4.11"
  }
}
