# Copy to .env and replace every placeholder with the existing Aiven MySQL details.
# URL-encode special characters in the username and password. Never commit .env.
NODE_ENV=development
PORT=3001
DATABASE_URL="mysql://<USER>:<URL_ENCODED_PASSWORD>@<AIVEN_HOST>:<PORT>/<DATABASE>?sslcert=./server/certs/ca.pem&sslaccept=strict"
FRONTEND_ORIGINS=http://localhost:5173
SESSION_TTL_DAYS=1
REMEMBER_SESSION_TTL_DAYS=30
